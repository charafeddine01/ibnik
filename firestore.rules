rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pairing channels: Allow reading and writing channel presence and battery telemetry
    match /channels/{channelId} {
      allow read, write: if true;
    }

    // WebRTC signaling calls and ICE candidates
    match /calls/{callId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // User profiles & authenticated data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
